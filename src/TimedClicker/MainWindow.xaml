<Window x:Class="TimedClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кликер на время" Width="820" Height="560" MinWidth="640" MinHeight="460"
        Background="#F3F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Кликер на время" FontSize="24" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Name="StartButton" Content="Начать" Click="StartButton_Click" Padding="16,6"/>
            <Button Content="Остановить" Click="StopButton_Click" Padding="16,6" Margin="8,0"/>
            <TextBlock Name="TimeTextBlock" Text="Время: 30,0 с" VerticalAlignment="Center" Margin="14,0"/>
            <TextBlock Name="PointsTextBlock" Text="Очки: 0" VerticalAlignment="Center" Margin="14,0"/>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Background="White">
            <Canvas Name="SceneCanvas" Background="Transparent" ClipToBounds="True"
                    MouseLeftButtonDown="SceneCanvas_MouseLeftButtonDown" SizeChanged="SceneCanvas_SizeChanged"/>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox Name="BonusesCheckBox" Content="Бонусные сферы и перезарядка (задание 2)" IsChecked="True"/>
            <TextBlock Name="CooldownTextBlock" Text="Перезарядка: 0,45 с" Margin="0,6"/>
            <TextBlock Name="SettingsTextBlock" Text="Появление: 0,80 с; время жизни: ×1"/>
            <WrapPanel Margin="0,6">
                <TextBlock Text="● Очки" Foreground="BlueViolet" Margin="0,0,12,0"/>
                <TextBlock Text="● Быстрый клик" Foreground="DodgerBlue" Margin="0,0,12,0"/>
                <TextBlock Text="● Дольше живут" Foreground="Green" Margin="0,0,12,0"/>
                <TextBlock Text="● Чаще появляются" Foreground="DarkOrange"/>
            </WrapPanel>
            <TextBlock Name="StatusTextBlock" Text="Нажимайте на появляющиеся круги. Раунд длится 30 секунд." TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
